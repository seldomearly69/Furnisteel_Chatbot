# PostgreSQL
POSTGRES_USER=furnisteel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=furnisteel_chat
DATABASE_URL=postgresql+psycopg2://furnisteel:changeme@postgres:5432/furnisteel_chat

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=furnisteel_knowledge

# Embeddings & RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_MAX_TOKENS=512
CHUNK_TOKENIZER_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_CANDIDATE_K=25
RETRIEVAL_HISTORY_MESSAGES=5
COMPLETION_HISTORY_MESSAGES=10

# OpenAI (required for chat responses)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RETRIEVAL_QUERY_MODEL=gpt-4o-mini

# Cohere (required for reranking)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# WhatsApp Cloud API (Meta Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=

# Optional public URL for webhook registration (e.g. ngrok)
WHATSAPP_CALLBACK_URL=

# Daily new customer email notifier
NEW_CUSTOMERS_EMAIL_TO=
NEW_CUSTOMERS_EMAIL_SUBJECT=New WhatsApp customers (last 24h)
NOTIFIER_TIMEZONE=Asia/Singapore
NOTIFIER_CRON=0 9 * * *          # minute hour day month day_of_week
NOTIFIER_RUN_ON_START=false
NOTIFIER_LOG_LEVEL=INFO

# Gmail / Google Workspace SMTP settings
# Recommended: create a Google "App Password" and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# App
APP_HOST=0.0.0.0
APP_PORT=8080
DOCUMENTS_DIR=/app/data/documents
COMPANY_NAME=Furnisteel Systems Pte Ltd
SYSTEM_PROMPT_PATH=

# Admin auth for UI/API
ADMIN_API_KEY=change-this-admin-key
JWT_SECRET=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXP_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dashboard.fmfurnisteel.com

# Built into chat-ui image at compile time
VITE_API_BASE=https://bot.fmfurnisteel.com

# Cloudflare R2 (S3-compatible) for WhatsApp images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
R2_KEY_PREFIX=whatsapp
R2_ENDPOINT_URL=
R2_REGION=auto
